package com.senikolo.pa2test;
import android.app.*;import android.os.*;import android.content.*;import android.view.*;import android.webkit.*;import android.graphics.Bitmap;import java.io.*;import java.util.concurrent.*;
public class PAProbe extends Instrumentation {
 boolean boardsOnly,verifyGpsRestart;
 StringBuilder log=new StringBuilder();
 void record(String s){log.append(s).append('\n');Bundle b=new Bundle();b.putString("stream",s+"\n");sendStatus(0,b);}
 void require(boolean condition,String why){if(!condition)throw new AssertionError(why);}
 int countText(View v,String wanted){
  int found=0;
  if(v instanceof android.widget.TextView && wanted.equals(((android.widget.TextView)v).getText().toString()))found++;
  if(v instanceof ViewGroup)for(int i=0;i<((ViewGroup)v).getChildCount();i++)found+=countText(((ViewGroup)v).getChildAt(i),wanted);
  return found;
 }
 WebView web(View v){if(v instanceof WebView)return(WebView)v;if(v instanceof ViewGroup)for(int i=0;i<((ViewGroup)v).getChildCount();i++){WebView w=web(((ViewGroup)v).getChildAt(i));if(w!=null)return w;}return null;}
 String js(Activity a,String source)throws Exception{CountDownLatch latch=new CountDownLatch(1);String[] result={""};runOnMainSync(()->{WebView w=web(a.getWindow().getDecorView());if(w==null){latch.countDown();return;}w.evaluateJavascript(source,v->{result[0]=v;latch.countDown();});});if(!latch.await(10,TimeUnit.SECONDS))throw new AssertionError("WebView callback timeout");return result[0];}
 void waitJs(Activity a,String expression,long max)throws Exception{long until=System.currentTimeMillis()+max;while(System.currentTimeMillis()<until){if("true".equals(js(a,expression)))return;Thread.sleep(300);}throw new AssertionError("UI timeout: "+expression+"; result="+js(a,"document.body.innerText.slice(-3000)"));}
 Activity launch(String name)throws Exception{Intent intent=new Intent().setClassName(getTargetContext().getPackageName(),"com.ispina.lokalnie."+name).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);Activity a=startActivitySync(intent);waitForIdleSync();Thread.sleep(900);require(a!=null,name+" did not start");return a;}
 void screenshot(String name)throws Exception{File dir=new File(getTargetContext().getFilesDir(),"pa2-tests");dir.mkdirs();Bitmap bitmap=getUiAutomation().takeScreenshot();if(bitmap!=null)try(FileOutputStream out=new FileOutputStream(new File(dir,name+".png"))){bitmap.compress(Bitmap.CompressFormat.PNG,100,out);}}
 @Override public void onCreate(Bundle args){super.onCreate(args);boardsOnly=args!=null&&"true".equals(args.getString("boardsOnly"));verifyGpsRestart=args!=null&&"true".equals(args.getString("verifyGpsRestart"));start();}
 @Override public void onStart(){Bundle out=new Bundle();try{
  record("Android API "+Build.VERSION.SDK_INT+", package "+getTargetContext().getPackageName());
  String iconRes=getTargetContext().getResources().getResourceEntryName(getTargetContext().getApplicationInfo().icon);
  require("ic_launcher".equals(iconRes)||"ic_launcher_round".equals(iconRes),"Original Alfa cat launcher was replaced: "+iconRes);
  record("PASS original adaptive cat launcher restored");
  Activity a=launch("MainActivity");record("PASS main launches");
  require(countText(a.getWindow().getDecorView(),"Planer i Alfa")==1,"Regional planner tile missing or duplicated");
  require(countText(a.getWindow().getDecorView(),"Najbliższe odjazdy")==1,"Premium nearby-stop dashboard missing or duplicated");
  record("PASS distinct regional planner and nearby-stop dashboard cards");
  if(verifyGpsRestart){record(com.ispina.lokalnie.PABoardsProbe.verifyGpsRestart(this,a));record("TOTAL PASS GPS tab process restart");out.putString("stream",log.toString());finish(Activity.RESULT_OK,out);return;}
  record(com.ispina.lokalnie.PABoardsProbe.run(this,a));
  if(boardsOnly){com.ispina.lokalnie.PABoardsProbe.leaveGps(this,a);record("TOTAL PASS system large-font small-screen boards");out.putString("stream",log.toString());finish(Activity.RESULT_OK,out);return;}
  screenshot("main");runOnMainSync(()->a.finish());
  Activity reopened=launch("MainActivity");com.ispina.lokalnie.PABoardsProbe.verifySaved(this,reopened);require(countText(reopened.getWindow().getDecorView(),"Najbliższe odjazdy")==1,"Reopen premium home");screenshot("home-reopened");runOnMainSync(()->reopened.finish());record("PASS main close and reopen with all saved shortcuts and exact manual platform");
  Activity planner=launch("PARegionsActivity");waitJs(planner,"document.getElementById('coverage').innerText.includes('offline')",30000);record("PASS WebView, all GTFS indexes and ES2017 client load");
   require("true".equals(js(planner,"/\\d{2}\\.\\d{2}\\.\\d{4}/.test(document.getElementById('dateDisplay').textContent)")),"Polish date format not visible");
   require("true".equals(js(planner,"document.getElementById('from').getAttribute('role')==='combobox' && document.getElementById('suggestFrom').getAttribute('role')==='listbox'")),"Stop search ARIA missing");
   require("true".equals(js(planner,"getComputedStyle(document.querySelector('header')).backgroundImage.includes('linear-gradient')")),"Branded header absent");
   record("PASS UX polish date, stop list accessibility and cohesive header");
  js(planner,"document.getElementById('from').value='Szwedzka';document.getElementById('from').dispatchEvent(new Event('input'));true");
  waitJs(planner,"document.getElementById('suggestFrom').innerText.includes('Warszawa')&&document.getElementById('suggestFrom').innerText.includes('Kraków')",10000);record("PASS identical stop names require Warsaw/Kraków geographic choice");
  js(planner,"document.getElementById('from').value='Tarchomin';document.getElementById('from').dispatchEvent(new Event('input'));document.getElementById('confirmFrom').click();document.getElementById('to').value='Dw. Centralny';document.getElementById('confirmTo').click();true");
  waitJs(planner,"document.querySelectorAll('.trip').length>0",60000);record("PASS automatic Tarchomin–Dw. Centralny real timetable search");screenshot("planner");
  js(planner,"document.getElementById('busQuick').click();document.getElementById('busStop').value='Tarchomin';document.getElementById('busStop').dispatchEvent(new Event('input'));true");
  waitJs(planner,"document.getElementById('liveBus').classList.contains('active') && document.querySelectorAll('#busStops button').length>0",12000);
  js(planner,"document.querySelector('#busStops button').click();true");
  waitJs(planner,"document.getElementById('busStopConfirmed').innerText.includes('Wybrano') && document.getElementById('busLine').options.length>1",12000);
  require("true".equals(js(planner,"document.querySelectorAll('nav .vicon').length===4 && document.getElementById('pa-bus')!==null && document.getElementById('busLine').options.length>1")),"LIVE bus icon/diagram utilities missing");
  String mapInit=js(planner,"var mapNode=document.createElement('div');mapNode.id='osmProbe';document.getElementById('busResult').replaceChildren(mapNode);PAMap.mount(mapNode,{lat:52.2,lon:21.0},{lat:52.201,lon:21.001});true");
  require("true".equals(mapInit),"Failed to initialize on-screen map: "+mapInit);
  waitJs(planner,"document.querySelectorAll('#osmProbe .osm-layer img').length>0 && document.querySelectorAll('#osmProbe .osm-marker').length===2",12000);
  String zoomBefore=js(planner,"document.querySelector('#osmProbe .osm-layer img').src");
  js(planner,"document.querySelector('#osmProbe .osm-buttons button').click();true");
  require(!zoomBefore.equals(js(planner,"document.querySelector('#osmProbe .osm-layer img').src")),"OpenStreetMap zoom control did not update tiles");
  screenshot("where-is-my-bus");record("PASS interactive OSM tile viewport, controls, stops, icons and vehicle markers");
  js(planner,"document.getElementById('busStop').value='Rondo ONZ';document.getElementById('busStop').dispatchEvent(new Event('input'));true");
  waitJs(planner,"Array.from(document.querySelectorAll('#busStops button')).some(b=>b.innerText.toLowerCase().includes('rondo onz'))",12000);
  js(planner,"Array.from(document.querySelectorAll('#busStops button')).find(b=>b.innerText.toLowerCase().includes('rondo onz')).click();true");
  waitJs(planner,"Array.from(document.getElementById('busLine').options).some(o=>o.textContent.includes('Tramwaj'))",12000);
  js(planner,"document.getElementById('busLine').selectedIndex=Array.from(document.getElementById('busLine').options).findIndex(o=>o.textContent.includes('Tramwaj'));document.getElementById('busLine').dispatchEvent(new Event('change'));true");
  waitJs(planner,"document.getElementById('busDirection').options.length>1 && !document.getElementById('busDirection').disabled",30000);
  record("PASS Warsaw Rondo ONZ: tram line choice and directions loaded from route patterns even without imminent departures");
  js(planner,"document.getElementById('tabAssistant').click();document.getElementById('chatInput').value='Chcę jutro po 9 jechać z Ispiny do Bochni';document.getElementById('ask').click();true");
  waitJs(planner,"document.getElementById('messages').innerText.includes('09:00')",20000);record("PASS chat retains requested date/time while clarifying Bochnia stop");
  js(planner,"document.getElementById('chatInput').value='Bochnia Dworzec PKP';document.getElementById('ask').click();true");
  waitJs(planner,"document.getElementById('messages').innerText.includes('Wybierz konkretny kurs')",60000);record("PASS chat completes MLD journey from clarification");
  js(planner,"document.getElementById('chatInput').value='A godzinę później?';document.getElementById('ask').click();true");
  waitJs(planner,"!document.getElementById('ask').disabled",60000);require(!js(planner,"document.getElementById('messages').lastElementChild.innerText").contains("Z którego przystanku"),"Lost origin on follow-up");record("PASS contextual one-hour-later follow-up");
  waitJs(planner,"document.querySelector('.composer').getBoundingClientRect().bottom <= document.querySelector('nav').getBoundingClientRect().top && document.getElementById('messages').clientHeight > 60 && document.getElementById('messages').scrollHeight-document.getElementById('messages').scrollTop-document.getElementById('messages').clientHeight < 5",10000);record("PASS composer stays above navigation and latest chat reply is visible on older WebView");screenshot("assistant");
  js(planner,"document.getElementById('chatInput').value='Zapisz notatkę: test PA2 mleko';document.getElementById('ask').click();true");waitJs(planner,"document.getElementById('messages').innerText.includes('Zapisałem w notatniku')",15000);require(getTargetContext().getSharedPreferences("native_notes",0).getString("note","").contains("test PA2 mleko"),"Native note missing");record("PASS native notes bridge persists in existing PA notepad");
  js(planner,"document.getElementById('settingsToggle').click();document.getElementById('theme').value='dark';document.getElementById('theme').dispatchEvent(new Event('change'));true");require(js(planner,"document.documentElement.dataset.theme").contains("dark"),"Dark theme missing");screenshot("dark");record("PASS dark appearance");runOnMainSync(()->planner.finish());
  for(String name:new String[]{"NotesActivity","RemindersActivity","RadioActivity","TvActivity","TubeActivity","WeatherActivity","AppearanceActivity","ReaderActivity"}){Activity module=launch(name);record("PASS module launch "+name+" (network playback not asserted)");runOnMainSync(()->module.finish());}
  record("TOTAL PASS system installation, launch and UI smoke");out.putString("stream",log.toString());finish(Activity.RESULT_OK,out);
 }catch(Throwable e){record("FAIL "+e);out.putString("stream",log.toString());finish(Activity.RESULT_CANCELED,out);}}
}
