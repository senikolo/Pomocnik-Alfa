package com.ispina.lokalnie;
import android.app.*;import android.content.*;import android.location.*;import android.os.*;import android.view.*;import android.widget.*;import android.graphics.Bitmap;import android.webkit.WebView;import org.json.*;import java.util.*;import java.util.concurrent.*;import java.io.*;import java.lang.reflect.*;
/** Real installed APK instrumentation. Synthetic parser fixtures are explicitly separate from real GTFS UI. */
public final class PABoardsProbe {
 static void need(boolean yes,String m){if(!yes)throw new AssertionError(m);}
 static Object get(Object o,String n)throws Exception{Field f=o.getClass().getDeclaredField(n);f.setAccessible(true);return f.get(o);}
 static void set(Object o,String n,Object v)throws Exception{Field f=o.getClass().getDeclaredField(n);f.setAccessible(true);f.set(o,v);}
 static PANearbyBoards controller()throws Exception{Field f=PANearbyBoards.class.getDeclaredField("installed");f.setAccessible(true);return (PANearbyBoards)f.get(null);}
 static void call(Object o,String name,Class<?>[] types,Object...args)throws Exception{Method m=o.getClass().getDeclaredMethod(name,types);m.setAccessible(true);m.invoke(o,args);}
 static int count(View v,String tag){int n=tag.equals(v.getTag())?1:0;if(v instanceof ViewGroup)for(int i=0;i<((ViewGroup)v).getChildCount();i++)n+=count(((ViewGroup)v).getChildAt(i),tag);return n;}
 static View tagged(View v,String tag){if(tag.equals(v.getTag()))return v;if(v instanceof ViewGroup)for(int i=0;i<((ViewGroup)v).getChildCount();i++){View r=tagged(((ViewGroup)v).getChildAt(i),tag);if(r!=null)return r;}return null;}
 static WebView web(View v){if(v instanceof WebView)return (WebView)v;if(v instanceof ViewGroup)for(int i=0;i<((ViewGroup)v).getChildCount();i++){WebView w=web(((ViewGroup)v).getChildAt(i));if(w!=null)return w;}return null;}
 static String js(Instrumentation t,Activity a,String expression)throws Exception{CountDownLatch done=new CountDownLatch(1);String[] result={""};t.runOnMainSync(()->{WebView w=web(a.getWindow().getDecorView());if(w==null){done.countDown();return;}w.evaluateJavascript(expression,value->{result[0]=value;done.countDown();});});need(done.await(10,TimeUnit.SECONDS),"Full board JS callback");return result[0];}
 static void waitFor(java.util.concurrent.Callable<Boolean> check,String name)throws Exception{long end=System.currentTimeMillis()+60000;while(System.currentTimeMillis()<end){if(check.call())return;Thread.sleep(150);}throw new AssertionError("Timed out: "+name);}
 static void geometry(View v){
  if(v instanceof TextView&&v.getTag()!=null&&"pa-board-title".equals(v.getTag())){TextView x=(TextView)v;need(x.getLayout()!=null,"Title laid out");for(int i=0;i<x.getLayout().getLineCount();i++)need(x.getLayout().getEllipsisCount(i)==0,"Uncut board title");need(x.getHeight()>=x.getLayout().getHeight(),"Title height includes all lines");}
  if(v instanceof ViewGroup)for(int i=0;i<((ViewGroup)v).getChildCount();i++)geometry(((ViewGroup)v).getChildAt(i));
 }
 static void screen(Instrumentation t,String name)throws Exception{File dir=new File(t.getTargetContext().getFilesDir(),"pa2-tests");dir.mkdirs();Bitmap b=t.getUiAutomation().takeScreenshot();need(b!=null,"Screenshot unavailable");try(FileOutputStream out=new FileOutputStream(new File(dir,name+".png"))){b.compress(Bitmap.CompressFormat.PNG,100,out);}}
 static byte[] var(long v)throws Exception{ByteArrayOutputStream o=new ByteArrayOutputStream();while((v&~127L)!=0){o.write((int)(v&127)|128);v>>>=7;}o.write((int)v);return o.toByteArray();}
 static byte[] join(byte[]...xs)throws Exception{ByteArrayOutputStream o=new ByteArrayOutputStream();for(byte[] x:xs)o.write(x);return o.toByteArray();}
 static byte[] num(int key,long n)throws Exception{return join(var(key*8),var(n));}
 static byte[] bin(int key,byte[] b)throws Exception{return join(var(key*8+2),var(b.length),b);}
 static byte[] str(int key,String s)throws Exception{return bin(key,s.getBytes("UTF-8"));}
 static byte[] fixture(long now,String trip,String day,String stop,int kind)throws Exception{
  byte[] descriptor=join(str(1,trip),str(3,day),num(4,kind==3?3:0));
  byte[] event=bin(3,num(2,now+300));byte[] point=join(str(4,stop),kind==1?num(5,1):kind==2?num(5,2):event);
  byte[] update=join(bin(1,descriptor),bin(2,point),num(4,now));return join(bin(1,join(str(1,"2.0"),num(3,now))),bin(2,bin(3,update)));
 }
 static void parserTests()throws Exception{
  long now=System.currentTimeMillis()/1000;String day=java.time.Instant.ofEpochSecond(now).atZone(java.time.ZoneId.of("Europe/Warsaw")).toLocalDate().toString();
  JSONObject q=new JSONObject().put("source","krakow_bus").put("trip","fixture-trip").put("serviceDay",day).put("stopId","krakow_bus:stop").put("plannedEpoch",now+120);
  for(int kind:new int[]{0,1,2,3,4,5,6}){
   PALive.cache.clear();PALive.fetched.clear();final int k=kind;byte[] data=fixture(k==4?now-300:now,k==5?"wrong-trip":"fixture-trip",k==6?"19990101":day.replace("-",""),"stop",kind);
   JSONObject answer=PALive.lookup(new JSONObject().put("departures",new JSONArray().put(q)),(url,max)->{if(url.contains("VehiclePositions"))throw new IOException("offline position source");return data;}).getJSONArray("results").getJSONObject(0);
   need(kind<=1||kind==3?answer.optBoolean("live"):!answer.optBoolean("live"),"GTFS-RT join kind "+kind);
   if(kind==0)need(answer.optLong("eta")==now+300&&answer.optLong("delaySeconds")==180,"fresh exact ETA/delay even if GPS source fails");
   if(kind==1)need(answer.optBoolean("skipped")&&answer.optLong("liveTimestamp")==now,"skipped timestamp");
   if(kind==3)need(answer.optBoolean("cancelled")&&answer.optLong("liveTimestamp")==now,"cancel timestamp");
  }
  // Network unavailable: honest plan, never fabricated ETA.
  PALive.cache.clear();PALive.fetched.clear();JSONObject no=PALive.lookup(new JSONObject().put("departures",new JSONArray().put(q)),(url,max)->{throw new IOException("no internet");}).getJSONArray("results").getJSONObject(0);need(!no.optBoolean("live")&&!no.has("eta"),"Offline does not invent LIVE");
  // Night service and holiday exceptions are represented by the exact service mask, not weekday guesses.
  JSONObject idx=new JSONObject("{\"schema\":2,\"days\":[\"2026-12-24\",\"2026-12-25\",\"2026-12-26\"],\"covered\":[true,true,false],\"sources\":[{\"id\":\"p\",\"covered\":[true,true,false]}],\"stops\":[[\"p:a\",\"Test\",\"01\",52,21,[0],\"p\",\"\"],[\"p:b\",\"End\",\"02\",52.01,21,[0],\"p\",\"\"]],\"routes\":[[\"p:r\",\"N1\",\"\",3,\"P\",\"p\"]]}");
  JSONObject route=new JSONObject("{\"patterns\":[[[0,0,0,0,0],[1,600,600,0,0]]],\"runs\":[[1,\"End\",0,90000,\"night\",\"\"],[2,\"End\",0,7200,\"holiday\",\"\"]]}");
  PANearbyData.Snapshot night=PANearbyData.load(idx,r->route,Arrays.asList(PANearbyData.stops(idx).get(0)),52,21,PANearbyRules.epoch("2026-12-25",1800));need(night.boards.get(0).departures.size()==2,"Night + holiday mask");need(night.boards.get(0).departures.get(0).day.equals("2026-12-24"),"Night retains previous service day");
  PANearbyData.Snapshot holiday=PANearbyData.load(idx,r->route,Arrays.asList(PANearbyData.stops(idx).get(0)),52,21,PANearbyRules.epoch("2026-12-26",1800));need(holiday.boards.get(0).departures.isEmpty()&&!holiday.boards.get(0).covered,"No extrapolated holiday service");
  PALive.cache.clear();PALive.fetched.clear();
 }
 interface UIAction{void run()throws Exception;}
 static void ui(Instrumentation t,UIAction action)throws Exception{
  Throwable[] error={null};t.runOnMainSync(()->{try{action.run();}catch(Throwable e){error[0]=e;}});
  if(error[0]!=null)throw new AssertionError("UI action failed",error[0]);
 }
 static void tap(Instrumentation t,Activity home,String tag)throws Exception{ui(t,()->{View v=tagged(home.getWindow().getDecorView(),tag);need(v!=null&&v.getVisibility()==View.VISIBLE,"Visible control "+tag);v.performClick();});}
 static Map<?,?> saved(PANearbyBoards c)throws Exception{return (Map<?,?>)get(c,"savedStops");}
 static boolean idle(PANearbyBoards c)throws Exception{return !((java.util.concurrent.atomic.AtomicBoolean)get(c,"computing")).get();}
 static boolean exact(PANearbyBoards c,String id)throws Exception{
  PANearbyData.Snapshot s=(PANearbyData.Snapshot)get(c,"snapshot");return s!=null&&s.boards.size()==1&&s.boards.get(0).stop.id.equals(id);
 }
 static void focus(Instrumentation t,Activity home)throws Exception{
  ui(t,()->{View v=tagged(home.getWindow().getDecorView(),"pa-stop-tabs");v.requestRectangleOnScreen(new android.graphics.Rect(0,0,v.getWidth(),v.getHeight()),true);});t.waitForIdleSync();Thread.sleep(350);
 }
 public static void verifySaved(Instrumentation t,Activity home)throws Exception{
  waitFor(()->controller()!=null&&get(controller(),"index")!=null,"restored home index");PANearbyBoards c=controller();
  JSONArray list=new JSONArray(t.getTargetContext().getSharedPreferences("pa2_boards",0).getString("saved_stops","[]"));need(list.length()>0,"Saved stops survive restart");need(saved(c).size()==list.length(),"All saved IDs restored");
  need((Boolean)get(c,"mineTab"),"My Stops tab restored");need(tagged(home.getWindow().getDecorView(),"pa-tab-mine").isSelected(),"My Stops tab visibly selected");
  for(int i=0;i<list.length();i++)need(tagged(home.getWindow().getDecorView(),"pa-saved-stop:"+list.getJSONObject(i).getString("id"))!=null,"Saved shortcut restored");
  String manual=t.getTargetContext().getSharedPreferences("pa2_boards",0).getString("manual_stop","");need(manual.equals(get(c,"manualId")),"Last manual selection restored");waitFor(()->idle(c)&&exact(c,manual),"Restored exact platform without GPS");
 }
 public static String verifyGpsRestart(Instrumentation t,Activity home)throws Exception{
  waitFor(()->controller()!=null&&get(controller(),"index")!=null,"GPS restart index");PANearbyBoards c=controller();need(!(Boolean)get(c,"mineTab"),"GPS tab survives process restart");need(tagged(home.getWindow().getDecorView(),"pa-tab-gps").isSelected(),"GPS tab visibly restored");need(saved(c).size()>0,"GPS choice does not erase saved stops");
  String manual=(String)get(c,"manualId");tap(t,home,"pa-tab-mine");waitFor(()->idle(c)&&exact(c,manual),"Switch to saved board after GPS restart");verifySaved(t,home);focus(t,home);screen(t,"tabs-gps-restart-to-mine");return "PASS GPS tab restored after process restart; My Stops retains its last platform and opens without GPS";
 }
 static void editRemove(Instrumentation t,Activity home,PANearbyBoards c,int which)throws Exception{
  int before=saved(c).size();tap(t,home,"pa-manage-stops");t.waitForIdleSync();
  waitFor(()->{ListView l=((AlertDialog)get(c,"savedDialog")).getListView();return l.getChildCount()>0&&l.isItemChecked(which<0?before-1:which);},"Editor checked rows laid out");Thread.sleep(350);screen(t,"moje-przystanki-edycja");
  ui(t,()->{AlertDialog d=(AlertDialog)get(c,"savedDialog");ListView l=d.getListView();for(int i=0;i<before;i++)if(which<0||i==which){need(l.isItemChecked(i),"Row initially checked");l.performItemClick(l.getChildAt(i),i,l.getAdapter().getItemId(i));need(!l.isItemChecked(i),"Tap unchecks row");}d.getButton(AlertDialog.BUTTON_POSITIVE).performClick();});
  waitFor(()->saved(c).size()==(which<0?0:before-1),"Editor callback");
 }
 static Location fix(PANearbyRules.Stop s){Location l=new Location("gps");l.setLatitude(s.lat);l.setLongitude(s.lon);l.setAccuracy(5);l.setTime(System.currentTimeMillis()+5000);return l;}
 static void useFix(Instrumentation t,PANearbyBoards c,Location loc)throws Exception{
  waitFor(()->idle(c),"prior calculation");ui(t,()->{call(c,"cancelLocation",new Class[]{});set(c,"lastRequest",System.currentTimeMillis());set(c,"lastLocation",loc);set(c,"signature","");call(c,"showNearby",new Class[]{});});
 }
 static void favorites(Instrumentation t,Activity home,PANearbyBoards c,PANearbyRules.Stop gpsExample,StringBuilder log)throws Exception{
  PANearbyData.Snapshot before=(PANearbyData.Snapshot)get(c,"snapshot");PANearbyRules.Stop first=before.boards.get(0).stop,second=before.boards.get(1).stop;need(!first.id.equals(second.id),"Distinct platform IDs");
  tap(t,home,"pa-save-stop:"+first.id);tap(t,home,"pa-save-stop:"+second.id);need(saved(c).size()==2,"Two platforms saved");need(!(Boolean)get(c,"mineTab")&&count(home.getWindow().getDecorView(),"pa-departure-board")==3,"Saving does not replace GPS view");need(tagged(home.getWindow().getDecorView(),"pa-my-stops").getVisibility()==View.GONE,"My Stops content hidden on GPS tab");
  long requested=(Long)get(c,"lastRequest");tap(t,home,"pa-tab-mine");waitFor(()->idle(c)&&exact(c,first.id),"Separate My Stops tab");need((Long)get(c,"lastRequest")==requested,"My Stops does not request GPS");need(tagged(home.getWindow().getDecorView(),"pa-tab-mine").isSelected(),"Mine tab active");need(tagged(home.getWindow().getDecorView(),"pa-saved-stop:"+second.id)!=null,"Second saved platform reachable");Thread.sleep(4500);focus(t,home);screen(t,"tabs-moje-przystanki");screen(t,"moje-przystanki");
  // New customization controls are exercised through actual dialogs.
  ui(t,()->tagged(home.getWindow().getDecorView(),"pa-saved-stop:"+first.id).performLongClick());
  ui(t,()->{AlertDialog dialog=(AlertDialog)get(c,"savedDialog");ListView list=dialog.getListView();list.performItemClick(list.getChildAt(0),0,list.getAdapter().getItemId(0));});
  ui(t,()->{AlertDialog dialog=(AlertDialog)get(c,"savedDialog");EditText alias=(EditText)tagged(dialog.getWindow().getDecorView(),"pa-stop-alias");alias.setText("Mój dom");dialog.getButton(AlertDialog.BUTTON_POSITIVE).performClick();});
  need(((JSONObject)saved(c).get(first.id)).optString("alias").equals("Mój dom"),"Custom name saved");
  need(((TextView)tagged(home.getWindow().getDecorView(),"pa-saved-stop:"+first.id)).getText().toString().contains("Mój dom"),"Custom name visible");
  for(int choice:new int[]{2,1}){ui(t,()->tagged(home.getWindow().getDecorView(),"pa-saved-stop:"+first.id).performLongClick());ui(t,()->{AlertDialog dialog=(AlertDialog)get(c,"savedDialog");ListView list=dialog.getListView();list.performItemClick(list.getChildAt(choice),choice,list.getAdapter().getItemId(choice));});need(new java.util.ArrayList<>(saved(c).keySet()).get(choice==2?1:0).equals(first.id),"Reorder preserves stable ID");}
  log.append("PASS actual custom name and move earlier/later dialogs preserve platform IDs\n");
  // Add from the actual My Stops tab, preserving exact ID without duplicates.
  tap(t,home,"pa-add-stop");ui(t,()->{AlertDialog d=(AlertDialog)get(c,"pickerDialog");((EditText)tagged(d.getWindow().getDecorView(),"pa-stop-search")).setText(first.id);ListView list=(ListView)tagged(d.getWindow().getDecorView(),"pa-stop-results");need(list.getAdapter().getCount()==1,"Exact manual match");need(((CheckBox)tagged(d.getWindow().getDecorView(),"pa-save-picked-stop")).isChecked(),"Save offered");list.performItemClick(list.getChildAt(0),0,list.getAdapter().getItemId(0));});
  waitFor(()->idle(c)&&exact(c,first.id),"Manual picker chosen platform");need(saved(c).size()==2,"Idempotent save");
  tap(t,home,"pa-saved-stop:"+second.id);tap(t,home,"pa-saved-stop:"+first.id);waitFor(()->idle(c)&&exact(c,first.id),"Rapid saved selection");
  // GPS has an independent selection and never clears the saved manual choice.
  Location loc=fix(gpsExample);ui(t,()->{set(c,"lastLocation",loc);set(c,"lastRequest",System.currentTimeMillis());});tap(t,home,"pa-tab-gps");waitFor(()->idle(c)&&!(Boolean)get(c,"mineTab")&&count(home.getWindow().getDecorView(),"pa-departure-board")==2,"GPS tab keeps automatic nearby selection");need(first.id.equals(get(c,"manualId")),"GPS keeps last saved stop");need(saved(c).size()==2,"GPS keeps favorites");focus(t,home);screen(t,"tabs-gps");
  tap(t,home,"pa-tab-mine");tap(t,home,"pa-tab-gps");tap(t,home,"pa-tab-mine");waitFor(()->idle(c)&&(Boolean)get(c,"mineTab")&&exact(c,first.id),"Latest tab choice wins over in-flight GPS");need(tagged(home.getWindow().getDecorView(),"pa-tab-mine").isSelected(),"Mine stays active after late GPS response");
  editRemove(t,home,c,1);need(saved(c).size()==1&&saved(c).containsKey(first.id),"Only unchecked platform removed");need(first.id.equals(get(c,"manualId")),"Removing another stop keeps current choice");
  ui(t,()->call(c,"selectStop",new Class[]{String.class},"unavailable:removed-platform"));waitFor(()->idle(c)&&get(c,"snapshot")!=null&&((PANearbyData.Snapshot)get(c,"snapshot")).boards.isEmpty(),"Unavailable saved ID");need(((TextView)((LinearLayout)get(c,"content")).getChildAt(0)).getText().toString().startsWith("Nie znaleziono stanowiska"),"Honest missing-stop explanation");tap(t,home,"pa-saved-stop:"+first.id);waitFor(()->idle(c)&&exact(c,first.id),"Return to saved platform");
  log.append("PASS actual tabs: GPS remains automatic after saving; separate My Stops view without GPS; add/remove; distinct platforms; duplicate prevention; independent choices; rapid tab changes ignore late GPS; unavailable-stop recovery\n");
 }
 public static String run(Instrumentation t,Activity home)throws Exception{
  parserTests();StringBuilder log=new StringBuilder("PASS instrumented GTFS-RT fixtures and midnight/holiday masks\n");
  waitFor(()->controller()!=null&&get(controller(),"index")!=null,"home index");PANearbyBoards c=controller();need(count(home.getWindow().getDecorView(),"pa-smart-boards")==1,"Actual dashboard card");need(count(home.getWindow().getDecorView(),"pa-stop-tabs")==1,"One real tab bar");
  boolean storedMine="mine".equals(t.getTargetContext().getSharedPreferences("pa2_boards",0).getString("boards_tab","gps"));need(storedMine==(Boolean)get(c,"mineTab"),"Stored tab restored, legacy alpha8 defaults to GPS");
  String previous=t.getTargetContext().getSharedPreferences("pa2_boards",0).getString("manual_stop","");need(previous.equals(get(c,"manualId")),"Previous manual ID retained");
  if(!saved(c).isEmpty()){
   if(!storedMine){need(tagged(home.getWindow().getDecorView(),"pa-my-stops").getVisibility()==View.GONE,"Legacy saves do not override GPS");tap(t,home,"pa-tab-mine");}
   verifySaved(t,home);need(previous.equals(get(c,"manualId")),"Alpha8/restart manual choice preserved");log.append("PASS existing saved stops and last platform retained; selected tab restored; saved view opens without GPS\n");
   editRemove(t,home,c,-1);waitFor(()->idle(c)&&((String)get(c,"manualId")).isEmpty()&&count(home.getWindow().getDecorView(),"pa-departure-board")==0,"Empty My Stops tab");need((Boolean)get(c,"mineTab"),"Empty saves do not fall back to GPS");focus(t,home);screen(t,"tabs-moje-puste");
  }
  boolean hasGPS=t.getTargetContext().checkSelfPermission(android.Manifest.permission.ACCESS_FINE_LOCATION)==android.content.pm.PackageManager.PERMISSION_GRANTED;
  waitFor(()->idle(c),"initial idle");ui(t,()->{call(c,"cancelLocation",new Class[]{});set(c,"lastLocation",null);set(c,"lastRequest",System.currentTimeMillis());call(c,"switchTab",new Class[]{boolean.class},false);});
  if(!hasGPS){waitFor(()->idle(c)&&count(home.getWindow().getDecorView(),"pa-departure-board")==0,"GPS denied, no default city");focus(t,home);screen(t,"boards-no-gps");log.append("PASS denied GPS path keeps My Stops tab available\n");}
  t.getUiAutomation().grantRuntimePermission(t.getTargetContext().getPackageName(),android.Manifest.permission.ACCESS_FINE_LOCATION);
  JSONObject index=(JSONObject)get(c,"index");List<PANearbyRules.Stop> all=PANearbyData.stops(index);Map<Integer,PANearbyRules.Stop> examples=new HashMap<>();String[] names={"Berensona","Tarchomin","Ispina","Grobla","Rondo ONZ","Rondo Mogilskie","Kraków Główny","Sierosławice","Białołęka","Łuczanowice","Wawrzyszew"};
  for(String name:names){for(PANearbyRules.Stop s:all)if(s.name.contains(name)){int n=PANearbyRules.choose(all,s.lat,s.lon).size();if(!examples.containsKey(n))examples.put(n,s);if(examples.size()==3)break;}if(examples.size()==3)break;}need(examples.size()==3,"Real GTFS supplies 1/2/3 layouts");
  for(int size=1;size<=3;size++){PANearbyRules.Stop s=examples.get(size);Location loc=fix(s);useFix(t,c,loc);final int expected=size;waitFor(()->idle(c)&&(Long)get(c,"displayedFix")==loc.getTime()&&count(home.getWindow().getDecorView(),"pa-departure-board")==expected,"Actual GPS board count "+size);focus(t,home);ui(t,()->geometry(home.getWindow().getDecorView()));screen(t,"boards-"+size);log.append("PASS GPS main dashboard "+size+" boards at "+s.name+" ["+s.id+"]\n");}
  favorites(t,home,c,examples.get(2),log);
  PANearbyRules.Stop manual=examples.get(2);ui(t,()->call(c,"selectStop",new Class[]{String.class},manual.id));waitFor(()->idle(c)&&exact(c,manual.id)&&tagged(home.getWindow().getDecorView(),"pa-save-stop:"+manual.id)!=null,"Manual exact platform");screen(t,"boards-manual");if(!saved(c).containsKey(manual.id))tap(t,home,"pa-save-stop:"+manual.id);
  Instrumentation.ActivityMonitor monitor=t.addMonitor(PARegionsActivity.class.getName(),null,false);tap(t,home,"pa-board-title");Activity detail=monitor.waitForActivityWithTimeout(20000);t.removeMonitor(monitor);need(detail!=null,"Full stop opens");need(manual.id.equals(detail.getIntent().getStringExtra("pa_stop_id")),"Exact platform deep link");waitFor(()->"true".equals(js(t,detail,"document.getElementById('stopBoard')?.classList.contains('active') && document.querySelectorAll('#homeStopRows .card').length>0")),"Full board rows");screen(t,"board-full-stop");need(!(Boolean)get(c,"visible"),"Offscreen polling paused");ui(t,()->detail.finish());
  ui(t,()->PANearbyBoards.install(home));waitFor(()->controller()!=c&&get(controller(),"index")!=null,"Reattached controller");verifySaved(t,home);need(count(home.getWindow().getDecorView(),"pa-smart-boards")==1,"No duplicate panel");focus(t,home);screen(t,"tabs-mine-restored");log.append("PASS Mine tab, saved list and exact platform survive home recreation; full stop deep link and foreground lifecycle\n");return log.toString();
 }
 public static void leaveGps(Instrumentation t,Activity home)throws Exception{
  PANearbyBoards c=controller();tap(t,home,"pa-tab-gps");waitFor(()->idle(c)&&!(Boolean)get(c,"mineTab"),"Leave GPS tab selected");need("gps".equals(t.getTargetContext().getSharedPreferences("pa2_boards",0).getString("boards_tab","")),"GPS mode persisted");focus(t,home);screen(t,"tabs-gps-before-restart");
 }
}
